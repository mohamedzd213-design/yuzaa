{
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/accueil",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/article",
      "destination": "/blog",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/infusions",
      "destination": "/pages/infusions.html"
    },
    {
      "source": "/produit-eveil",
      "destination": "/pages/produit-eveil.html"
    },
    {
      "source": "/produit-focus",
      "destination": "/pages/produit-focus.html"
    },
    {
      "source": "/produit-rush",
      "destination": "/pages/produit-rush.html"
    },
    {
      "source": "/coffrets",
      "destination": "/pages/coffrets.html"
    },
    {
      "source": "/coffret-decouverte",
      "destination": "/pages/coffret-decouverte.html"
    },
    {
      "source": "/coffret-partiels",
      "destination": "/pages/coffret-partiels.html"
    },
    {
      "source": "/coffret-boule",
      "destination": "/pages/coffret-boule.html"
    },
    {
      "source": "/pros",
      "destination": "/pages/pros.html"
    },
    {
      "source": "/histoire",
      "destination": "/pages/histoire.html"
    },
    {
      "source": "/engagements",
      "destination": "/pages/engagements.html"
    },
    {
      "source": "/blog",
      "destination": "/pages/blog.html"
    },
    {
      "source": "/faq",
      "destination": "/pages/faq.html"
    },
    {
      "source": "/contact",
      "destination": "/pages/contact.html"
    },
    {
      "source": "/cgv",
      "destination": "/pages/cgv.html"
    },
    {
      "source": "/cgu",
      "destination": "/pages/cgu.html"
    },
    {
      "source": "/mentions",
      "destination": "/pages/mentions.html"
    },
    {
      "source": "/article-boisson-energisante",
      "destination": "/pages/article-boisson-energisante.html"
    },
    {
      "source": "/article-cafeine-moment",
      "destination": "/pages/article-cafeine-moment.html"
    },
    {
      "source": "/article-trois-plantes",
      "destination": "/pages/article-trois-plantes.html"
    },
    {
      "source": "/article-bien-infuser",
      "destination": "/pages/article-bien-infuser.html"
    },
    {
      "source": "/article-rituels-examens",
      "destination": "/pages/article-rituels-examens.html"
    },
    {
      "source": "/article-rush-latte",
      "destination": "/pages/article-rush-latte.html"
    },
    {
      "source": "/(compte|compte-commandes|suivi|compte-profil|merci|panier|connexion|livraison|paiement|confirmation|merci-newsletter)",
      "destination": "/app.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/js/min/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/js/vendor/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    },
    {
      "source": "/(css|js)/([^/]+)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(llms.txt|robots.txt|sitemap.xml)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        }
      ]
    }
  ]
}
